{
  "name": "@atlure/types",
  "version": "0.8.0",
  "description": "Atlure domain model: shared entity and value types for the mobile app, the marketing site and the backend",
  "license": "MIT",
  "author": "David Moreira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simpxlify/atlure-ui.git",
    "directory": "packages/types"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm run build && node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
