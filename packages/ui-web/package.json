{
  "name": "@atlure/ui-web",
  "version": "0.12.3",
  "description": "Atlure web components: the DOM render layer for the marketing surface, sharing cva variant recipes with @atlure/ui",
  "license": "MIT",
  "author": "David Moreira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simpxlify/atlure-ui.git",
    "directory": "packages/ui-web"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./variants": {
      "import": {
        "types": "./dist/variants/index.d.ts",
        "default": "./dist/variants/index.js"
      },
      "require": {
        "types": "./dist/variants/index.d.cts",
        "default": "./dist/variants/index.cjs"
      }
    },
    "./theme-script": {
      "import": {
        "types": "./dist/theme/theme-script.d.ts",
        "default": "./dist/theme/theme-script.js"
      },
      "require": {
        "types": "./dist/theme/theme-script.d.cts",
        "default": "./dist/theme/theme-script.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@atlure/tailwind-preset": "workspace:*",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
