{
  "name": "storybook-web",
  "private": true,
  "description": "Atlure design-system workbench. Never published; lives outside every published package by design.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "build": "pnpm run storybook:build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs"
  },
  "dependencies": {
    "@atlure/ui": "workspace:*",
    "@atlure/ui-web": "workspace:*",
    "nativewind": "4.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.81.4",
    "react-native-web": "0.21.1"
  },
  "devDependencies": {
    "@atlure/tailwind-preset": "workspace:*",
    "@atlure/tokens": "workspace:*",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-native-web-vite": "9.1.20",
    "@storybook/react-vite": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "postcss": "8.5.6",
    "postcss-import": "^16.1.0",
    "storybook": "^9.0.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^6.0.0"
  }
}
