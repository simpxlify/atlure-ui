{
  "name": "atlure-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "generate": "pnpm --filter @atlure/tokens generate",
    "changeset": "changeset",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "verify:packaging:update": "node scripts/verify-packaging.mjs --update",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.7",
    "@types/node": "22.19.0",
    "publint": "0.3.14",
    "typescript": "5.9.3"
  }
}
